{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Techniques",
  "description": "Techniques with documented associations; definitions still to be sourced.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^(TEC)-[A-Z0-9-]+$"
      },
      "name": {
        "type": "string"
      },
      "alternative_names": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "category": {
        "type": "string"
      },
      "associated_entity_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^(PER|FAM|ORG)-[A-Z0-9-]+$"
        }
      },
      "example_work_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^(WRK)-[A-Z0-9-]+$"
        }
      },
      "documented_uses": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "working_definition": {
        "type": [
          "string",
          "null"
        ]
      },
      "definition_status": {
        "type": "string"
      },
      "editorial_status": {
        "enum": [
          "draft",
          "reviewed"
        ]
      },
      "verification_status": {
        "enum": [
          "VERIFIED",
          "PARTIALLY_VERIFIED",
          "ATTRIBUTED",
          "DISPUTED",
          "UNVERIFIED"
        ]
      },
      "source_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^(SRC)-[A-Z0-9-]+$"
        }
      },
      "notes": {
        "type": [
          "string",
          "null"
        ]
      },
      "checked": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      }
    },
    "required": [
      "id",
      "name",
      "category",
      "verification_status",
      "source_ids"
    ],
    "additionalProperties": false
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Works",
  "description": "Museum-documented reference works only. credit_line_maker is the museum's verbatim maker string.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^(WRK)-[A-Z0-9-]+$"
      },
      "title": {
        "type": "string"
      },
      "date": {
        "type": [
          "string",
          "null"
        ]
      },
      "medium": {
        "type": [
          "string",
          "null"
        ]
      },
      "institution": {
        "type": "string"
      },
      "accession_number": {
        "type": "string"
      },
      "object_url": {
        "type": "string"
      },
      "credit_line_maker": {
        "type": "string"
      },
      "designer_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^(PER|FAM|ORG)-[A-Z0-9-]+$"
        }
      },
      "maker_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^(PER|FAM)-[A-Z0-9-]+$"
        }
      },
      "workshop_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^(ORG)-[A-Z0-9-]+$"
        }
      },
      "candidate_workshop_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^(ORG)-[A-Z0-9-]+$"
        }
      },
      "attribution_status": {
        "enum": [
          "VERIFIED",
          "PARTIALLY_VERIFIED",
          "ATTRIBUTED",
          "DISPUTED",
          "UNVERIFIED"
        ]
      },
      "technique_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^(TEC)-[A-Z0-9-]+$"
        }
      },
      "source_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^(SRC)-[A-Z0-9-]+$"
        }
      },
      "museum_public_domain_flag": {
        "type": "boolean"
      },
      "checked": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "notes": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "id",
      "title",
      "institution",
      "object_url",
      "credit_line_maker",
      "attribution_status",
      "source_ids"
    ],
    "additionalProperties": false
  }
}